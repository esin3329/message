{
  "name": "@repo/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0 <25"
  },
  "exports": {
    "./app-type": {
      "types": "./src/app.ts",
      "import": "./src/app.ts"
    },
    "./socket-types": {
      "types": "./src/ws/events.ts",
      "import": "./src/ws/events.ts"
    }
  },
  "scripts": {
    "dev": "node --watch --import tsx/esm src/index.ts",
    "build": "tsc -b",
    "start": "node dist/src/index.js",
    "db:migrate": "prisma migrate dev --name init",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@hono/zod-validator": "0.9.1",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^16.4.7",
    "hono": "catalog:",
    "hono-rate-limiter": "0.5.4",
    "jose": "^6.1.0",
    "socket.io": "4.8.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "5.0.3",
    "socket.io-client": "4.8.4"
  }
}
